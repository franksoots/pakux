"use client";

import Link from "next/link";
import { motion } from "framer-motion";
import { useState } from "react";
import { useRouter } from "next/navigation";

import { useLanguage } from "../../components/language-provider";
import LanguageSwitcher from "../../components/language-switcher";
import { createClient } from "../../lib/supabase/client";

export default function LoginPage() {
  const { t, language } = useLanguage();
  const router = useRouter();

  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");

  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  async function handleLogin(
    event: React.FormEvent<HTMLFormElement>,
  ) {
    event.preventDefault();

    console.log("PAKUX: login button clicked");

    setLoading(true);
    setError("");

    try {
      const supabase = createClient();

      console.log("PAKUX: Supabase client created");
      console.log("PAKUX: logging in:", email);

      const {
        data,
        error: loginError,
      } = await supabase.auth.signInWithPassword({
        email: email.trim(),
        password,
      });

      console.log("PAKUX: login response", {
        data,
        error: loginError,
      });

      if (loginError) {
        setError(loginError.message);
        setLoading(false);
        return;
      }

      if (!data.user) {
        setError(
          language === "et"
            ? "Sisselogimine ebaõnnestus."
            : "Login failed.",
        );
        setLoading(false);
        return;
      }

      console.log(
        "PAKUX: login successful",
        data.user.email,
      );

      router.replace("/dashboard");
      router.refresh();
    } catch (err) {
      console.error(
        "PAKUX: login crashed",
        err,
      );

      setError(
        err instanceof Error
          ? err.message
          : "Something went wrong.",
      );

      setLoading(false);
    }
  }

  return (
    <main className="pk-auth-page">
      <div className="pk-auth-background" />

      <div className="pk-auth-topbar">
        <Link
          href="/"
          className="pk-logo"
        >
          <span className="pk-logo-mark" />
          <span className="pk-logo-text">
            pakux
          </span>
        </Link>

        <LanguageSwitcher />
      </div>

      <motion.div
        className="pk-auth-container"
        initial={{
          opacity: 0,
          y: 18,
        }}
        animate={{
          opacity: 1,
          y: 0,
        }}
      >
        <div className="pk-auth-card">
          <div className="pk-auth-header">
            <div className="pk-eyebrow">
              PAKUX
            </div>

            <h1 className="pk-auth-title">
              {t.auth.loginTitle}
            </h1>

            <p className="pk-auth-subtitle">
              {t.auth.loginSubtitle}
            </p>
          </div>

          <form
            className="pk-auth-form"
            onSubmit={handleLogin}
          >
            <div className="pk-field">
              <label className="pk-label">
                {t.auth.email}
              </label>

              <input
                className="pk-input"
                type="email"
                placeholder="you@example.com"
                value={email}
                onChange={(event) =>
                  setEmail(
                    event.target.value,
                  )
                }
                required
              />
            </div>

            <div className="pk-field">
              <label className="pk-label">
                {t.auth.password}
              </label>

              <input
                className="pk-input"
                type="password"
                placeholder="••••••••"
                value={password}
                onChange={(event) =>
                  setPassword(
                    event.target.value,
                  )
                }
                required
              />
            </div>

            {error && (
              <div
                style={{
                  padding:
                    "12px 14px",
                  borderRadius: 10,
                  border:
                    "1px solid rgba(255,80,80,.25)",
                  background:
                    "rgba(255,80,80,.08)",
                  color: "#ff8b8b",
                  fontSize: 13,
                  lineHeight: 1.5,
                }}
              >
                {error}
              </div>
            )}

            <button
              type="submit"
              className="pk-button pk-auth-submit"
              disabled={loading}
            >
              {loading
                ? language === "et"
                  ? "Logimine..."
                  : "Signing in..."
                : t.auth.loginButton}

              {!loading && (
                <span>→</span>
              )}
            </button>
          </form>

          <div className="pk-auth-divider">
            <span>
              {language === "et"
                ? "või"
                : "or"}
            </span>
          </div>

          <div className="pk-auth-footer">
            <span>
              {t.auth.noAccount}
            </span>

            <Link href="/signup">
              {t.auth.signup}
            </Link>
          </div>
        </div>

        <div className="pk-auth-note">
          <span className="pk-status-dot" />

          {language === "et"
            ? "Turvaline autentimine sinu Pakuxi tööruumi jaoks."
            : "Secure authentication for your Pakux workspace."}
        </div>
      </motion.div>
    </main>
  );
}